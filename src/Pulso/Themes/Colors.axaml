<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#C5F36A</Color>
            <Color x:Key="SystemAccentColorDark1">#A9D955</Color>
            <Color x:Key="SystemAccentColorDark2">#8DBF42</Color>
            <Color x:Key="SystemAccentColorDark3">#6F8F3D</Color>
            <Color x:Key="SystemAccentColorLight1">#D4FF80</Color>
            <Color x:Key="SystemAccentColorLight2">#DFFF9F</Color>
            <Color x:Key="SystemAccentColorLight3">#EAFFC0</Color>
            <SolidColorBrush x:Key="Bg" Color="#161918"/>
            <SolidColorBrush x:Key="TitleBar" Color="#121514"/>
            <SolidColorBrush x:Key="Sidebar" Color="#1B1E1D"/>
            <SolidColorBrush x:Key="SidebarCard" Color="#222624"/>
            <SolidColorBrush x:Key="Card" Color="#1F2321"/>
