            <SolidColorBrush x:Key="CloseHover" Color="#C4352B"/>
            <SolidColorBrush x:Key="Grid" Color="#2A2F2C"/>
            <SolidColorBrush x:Key="SeriesLime" Color="#C5F36A"/>
