<Window x:Class="Pulso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pulso.Core"
        Title="Pulso" Width="1440" Height="920" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Icon="Assets/pulso.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Item "Sistema": não fica com fundo quando aberto, só a cor limão -->
        <Style x:Key="NavParent" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" CornerRadius="10" Padding="12,10">
                            <DockPanel>
                                <Viewbox Width="17" Height="17" DockPanel.Dock="Left">
                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="24" Height="24" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <Viewbox x:Name="chev" Width="12" Height="12" DockPanel.Dock="Right" RenderTransformOrigin="0.5,0.5">
                                    <Path Data="M9 6l6 6-6 6" Width="24" Height="24" Stroke="{TemplateBinding Foreground}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Viewbox>
                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderThickness="1" BorderBrush="{DynamicResource Border}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Border Background="{DynamicResource TitleBar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource AccentFill}"/>
                        <TextBlock Text="Pulso" Margin="10,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2}"/>
                        <TextBlock Text="{l:T Diagnóstico e monitoramento de hardware, En='Hardware diagnostics and monitoring'}" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        <Border x:Name="AdminBadge" Visibility="Collapsed" Margin="12,0,0,0" CornerRadius="6" Padding="8,2" Background="{DynamicResource WarnBg}">
                            <TextBlock Text="{l:T Modo limitado — sem administrador, En='Limited mode — not administrator'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Warn}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Barra lateral -->
                <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="14,20,14,20">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,22">
                            <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource LogoRing}" Padding="4">
                                <Border CornerRadius="19" Background="{DynamicResource AccentFill}">
                                    <Viewbox Width="20" Height="20">
                                        <Path Data="M3 12h4l3-6 4 12 3-6h4" Width="24" Height="24" Stroke="{DynamicResource AccentText}" StrokeThickness="2.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pulso" FontWeight="ExtraBold" FontSize="17"/>
                                <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Consumo do próprio app -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarCard}" CornerRadius="14" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T CONSUMO DO PULSO, En='PULSO FOOTPRINT'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="AppCpu" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                                    <TextBlock Text="CPU" FontSize="12.5" Foreground="{DynamicResource Text3}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="AppRam" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                                    <TextBlock Text="RAM" FontSize="12.5" Foreground="{DynamicResource Text3}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="AppInterval" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                                    <TextBlock Text="{l:T Leitura, En='Sampling'}" FontSize="12.5" Foreground="{DynamicResource Text3}"/>
                                </DockPanel>
                                <TextBlock x:Name="AppNote" FontSize="11" Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap" LineHeight="15"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel x:Name="Nav"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Conteúdo -->
                <ContentControl x:Name="Host" Grid.Column="1" Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
